{
  "name": "lumina-minecraft-launcher",
  "version": "1.0.0",
  "description": "A polished modern Minecraft launcher for Windows",
  "author": "x2super",
  "homepage": "https://github.com/x2super/Lumina-mc",
  "repository": {
    "type": "git",
    "url": "https://github.com/x2super/Lumina-mc.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/animations.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.x2super.lumina",
    "productName": "Lumina Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumina Launcher"
    }
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide": "^1.46.0",
    "minecraft-launcher-core": "^3.18.2",
    "motion": "^13.4.0",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8"
  }
}
